ENVIRONMENT=development
APP_NAME=MediCORE
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=catalog-pdfs
DATABASE_URL=postgresql+psycopg://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password

REDIS_URL=redis://localhost:6379/0

GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

EMAIL_MODE=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=supplier-inbox@example.com
IMAP_PASSWORD=app-password-or-oauth-token
IMAP_MAILBOX=INBOX

GMAIL_WEBHOOK_TOKEN=change-me
GMAIL_OAUTH_TOKEN=oauth-access-token
GMAIL_USER_ID=me
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PUBSUB_TOPIC=gmail-supplier-topic

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
MOCK_DATA_ENABLED=false


